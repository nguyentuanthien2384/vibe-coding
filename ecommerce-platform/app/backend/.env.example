# Database Configuration (MySQL)
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/ecommerce_db"

# Server Configuration
NODE_ENV=development
PORT=3001
FRONTEND_URL="http://localhost:3000"

# Redis Cache & Session Configuration
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD=""

# JWT Security Secrets
JWT_SECRET="your_access_token_secret_key"
JWT_REFRESH_SECRET="your_refresh_token_secret_key"

# Mail Service & SMTP Configuration
MAIL_HOST="smtp.ethereal.email"
MAIL_PORT=587
MAIL_USER="your_smtp_username"
MAIL_PASS="your_smtp_password"
MAIL_FROM="\"TechBite Platform\" <noreply@techbite.vn>"
